# --- Environment ---
APP_ENV_FILE=.env
SPRING_PROFILES_ACTIVE=dev

# --- Server ---
SERVER_PORT=8080

# --- Database (MySQL) ---
MYSQL_HOST=mysql-db
MYSQL_PORT=3306
MYSQL_DATABASE=studiostkoh.portafolio
MYSQL_ROOT_PASSWORD=change-root
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_PARAMS=useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- Security & JWT ---
# Base64-encoded HMAC key, at least 256 bits after decoding.
JWT_TOKEN=replace-with-base64-encoded-32-byte-secret
JWT_EXPIRATION_TIME=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_ISSUER=portfolio-hub
JWT_AUDIENCE=portfolio-hub-api
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Google OAuth2 Login ---
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me

# --- Google Drive API ---
GOOGLE_DRIVE_ENABLED=true
DRIVE_OAUTH_CLIENT_ID=replace-me
DRIVE_OAUTH_CLIENT_SECRET=replace-me
DRIVE_OAUTH_REFRESH_TOKEN=replace-me
DRIVE_FOLDER_USER_AVATARS=replace-me
DRIVE_FOLDER_USER_RESUMES=replace-me
DRIVE_FOLDER_PROJECTS_COVER=replace-me
DRIVE_FOLDER_SKILLS_ICON=replace-me
DRIVE_FOLDER_CERTIFICATES=replace-me

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_APP_EMAIL=replace-me@example.com
GMAIL_APP_PASSWORD=replace-me
EMAIL_VERIFICATION_EXPIRATION_MINUTES=1440
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/verify-email

# --- Frontend & CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_ALLOWED_REDIRECTS=http://localhost:5173
FRONTEND_DEFAULT_REDIRECT=http://localhost:5173/auth/callback

# --- Uploads ---
UPLOAD_MAX_IMAGE_SIZE=2MB
UPLOAD_MAX_DOCUMENT_SIZE=5MB

# --- Observability ---
ACTUATOR_EXPOSE_DETAILS=never
